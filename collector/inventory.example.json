{
  "_note": "Example only. The real inventory lives in the GitHub secret PATCH_INVENTORY (or collector/inventory.local.json, which git ignores). Only 'name' is ever published.",
  "platforms": [
    {
      "name": "Windows",
      "source": "msrc",
      "products": "^Windows Server 2022",
      "severities": [
        "Critical"
      ],
      "news": "\\bWindows\\b"
    },
    {
      "name": "Linux",
      "source": "redhat",
      "products": [
        "Red Hat Enterprise Linux 9"
      ],
      "severities": [
        "critical"
      ],
      "news": "Red Hat|RHEL"
    },
    {
      "name": "AIX",
      "source": "aix",
      "match": "7\\.3"
    },
    {
      "name": "Database",
      "source": "nvd",
