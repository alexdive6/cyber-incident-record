      "match": "12\\.1",
      "source_id": "ibm",
      "advisory_hosts": [
        "ibm.com/support"
      ]
    },
    {
      "name": "App server",
      "source": "nvd",
      "keyword": "WebSphere Application Server",
      "match": "9\\.0",
      "min_cvss": 9
    },
    {
      "name": "Network",
      "source": "cisco",
      "match": "NX-OS"
    }
  ]
}
